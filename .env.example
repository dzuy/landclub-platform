# LOCAL ONLY: development shortcut; never set this on Railway.
LAND_CLUB_LOCAL_STAFF=1

# Railway runtime variables (all server-side; keep the secret key server-only).
# DATABASE_URL=postgresql://...
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# STAFF_USER_IDS=confirmed-staff-user-uuid,another-confirmed-staff-user-uuid
# Canonical HTTPS origin for password-recovery email links (required when hosted).
# LAND_CLUB_SITE_URL=https://landclub.up.railway.app
# Optional first deployment: insert missing fictional properties as published demos.
# SEED_DEMO_CONTENT=true

# Live Notion property sync (server-only; optional until configured).
# Add a read-content internal connection to the Notion Properties database.
# NOTION_TOKEN=your-internal-connection-token
# NOTION_DATA_SOURCE_ID=your-properties-data-source-id

# Photos: local development defaults to private files outside public/.
# PHOTO_STORAGE_BACKEND=local
# PHOTO_STORAGE_DIR=/absolute/path/to/.data/property-photos
# Hosted uploads require PHOTO_STORAGE_BACKEND=supabase and the server-only key above.
# PHOTO_STORAGE_BUCKET=property-photos
# Shared upload/import limit: 20 MiB (20,971,520 bytes); verify the bucket matches.
